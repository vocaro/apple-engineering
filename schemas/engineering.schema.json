{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vocaro engineering project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string"
    },
    "toolkit": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "app-extensions",
          "background-mac",
          "background-processing",
          "data-protection",
          "external-validation",
          "file-handoff",
          "measurement",
          "native-python",
          "packaging",
          "simulator-disposable",
          "simulator-pool",
          "voiceover"
        ]
      }
    },
    "integration": {
      "enum": [
        "direct-main",
        "pull-request"
      ]
    },
    "hostedRepositories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "voiceover": {
      "type": "object",
      "properties": {
        "workflows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "reason"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "command"
        ],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resource": {
            "enum": [
              "light",
              "heavy",
              "exclusive"
            ]
          },
          "minimumTests": {
            "type": "integer",
            "minimum": 1
          },
          "timeout": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
