{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vocaro engineering project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string"
    },
    "toolkit": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "app-extensions",
          "background-assets",
          "background-mac",
          "background-processing",
          "data-protection",
          "external-validation",
          "file-handoff",
          "foundation-models",
          "measurement",
          "native-python",
          "packaging",
          "simulator-disposable",
          "simulator-pool",
          "storekit",
          "voiceover"
        ]
      }
    },
    "integration": {
      "enum": [
        "direct-main",
        "pull-request"
      ]
    },
    "hostedRepositories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "voiceover": {
      "type": "object",
      "properties": {
        "workflows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "reason"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "command"
        ],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resource": {
            "enum": [
              "light",
              "heavy",
              "exclusive"
            ]
          },
          "minimumTests": {
            "type": "integer",
            "minimum": 1
          },
          "timeout": {
            "type": "integer",
            "minimum": 1
          },
          "foreground": {
            "description": "The lane takes the owner's screen, as a Mac XCUITest lane does: eng run refuses it unless VOCARO_DEVICE_OWNER holds mac-foreground in the device record",
            "type": "boolean"
          },
          "buildHost": {
            "description": "A heavy or exclusive lane that needs no simulator, device, screen (background Mac UI tests included) or timing measurement: eng run sends it at a committed tree to the owner's build host first, and runs it here when the build host cannot take it",
            "type": "boolean"
          }
        }
      }
    },
    "spelling": {
      "description": "Exemptions from eng spelling, each mapped to the reason it is kept",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skip": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "minLength": 1
          },
          "description": "Tracked paths neither read nor judged by name; a key ending in / is a directory"
        },
        "exemptPhrases": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "minLength": 1
          },
          "description": "Case-sensitive text removed before a line is read, such as a standard's term"
        },
        "exemptRuns": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "minLength": 1
          },
          "description": "Whole identifiers another project named, such as MonoBehaviour"
        },
        "exemptTokens": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "minLength": 1
          },
          "description": "Case-sensitive subwords, such as a proper name"
        }
      }
    }
  }
}
