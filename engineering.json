{
  "schemaVersion": 1,
  "name": "apple-engineering",
  "toolkit": {
    "path": "."
  },
  "capabilities": [],
  "lanes": {
    "python-tests": {
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "resource": "light",
      "minimumTests": 43
    }
  },
  "spelling": {
    "skip": {
      "licenses/": "upstream license texts, retained verbatim",
      "tests/test_spelling.py": "plants British spellings as the check's negative controls"
    },
    "exemptPhrases": {
      "colour type": "the PNG specification's name for the IHDR field"
    }
  },
  "exceptions": []
}
